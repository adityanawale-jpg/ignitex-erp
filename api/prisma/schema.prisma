/// Purchase Management → Purchase Requisition. One row per requisition, each
/// naming a single item; requisitions raised off the same demand are tied
/// together by the ref_request_number / ref_request_source / ref_source_reference
/// triplet rather than by a shared header row.
///
/// item_id points at one of five item masters, picked by itemtype — polymorphic,
/// so no relation is declared (same shape as bom_fg_detail.item_id).
///
/// Status is the is_active / deactivation_reason pair every master here uses —
/// there is no submit/approve lifecycle on a requisition.
model purchase_requisition {
  id                   Int       @id @default(autoincrement())
  requisition_number   String?   @unique @db.VarChar(30)
  requisition_date     DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  itemtype             String    @db.VarChar(20)
  item_id              Int?
  sku_code             String    @db.VarChar(300)
  item_description     String?   @db.VarChar(500)
  item_qty             Int       @default(0)
  uom                  String?   @db.VarChar(20)
  gross_weight         Decimal?  @default(0) @db.Decimal(14, 4)
  net_weight           Decimal?  @default(0) @db.Decimal(14, 4)
  pure_weight          Decimal?  @default(0) @db.Decimal(14, 4)
  is_vendor_mapped     Boolean   @default(false)
  vendor_item_no       String?   @db.VarChar(100)
  ref_request_number   String?   @db.VarChar(100)
  ref_request_source   String?   @db.VarChar(50)
  ref_source_reference String?   @db.VarChar(200)
  required_date        DateTime? @db.Date
  remarks              String?   @db.VarChar(500)
  is_active            Boolean?  @default(true)
  deactivation_reason  String?   @db.VarChar(500)
  deactivated_at       DateTime? @db.Timestamp(6)
  created_by           Int?
  updated_by           Int?
  created_at           DateTime? @default(now()) @db.Timestamp(6)
  updated_at           DateTime? @default(now()) @db.Timestamp(6)

  @@index([is_active], map: "idx_pr_active")
  @@index([requisition_date(sort: Desc)], map: "idx_pr_date")
  @@index([itemtype], map: "idx_pr_itemtype")
  @@index([sku_code], map: "idx_pr_sku")
  @@index([ref_request_number], map: "idx_pr_ref_req")
}

/// Purchase Management → Purchase Order. Header/lines, unlike
/// purchase_requisition: a PO is placed with ONE supplier for MANY items, so
/// the supplier, the addresses, the payment term and the money totals sit once
/// at the top. Deliberately mirrors sales_order_hdr / sales_order_lines — a PO
/// is the buy-side twin of a sales order.
///
/// The supplier's address, communication email and payment term are copied in
/// at order time rather than joined on read, so a PO still prints the terms it
/// was actually placed under after supplier_master is edited.
model purchase_order_hdr {
  id                   Int                    @id @default(autoincrement())
  po_number            String?                @unique @db.VarChar(30)
  buss_unit_id         String                 @db.VarChar(50)
  supplier_id          Int
  supplier_address     String?
  comm_email           String?                @db.VarChar(255)
  pay_term             String?                @db.VarChar(50)
  ship_to_location     String?
  bill_to_location     String?
  currency_code        String                 @default("INR") @db.VarChar(10)
  po_date              DateTime               @default(dbgenerated("CURRENT_DATE")) @db.Date
  expected_date        DateTime?              @db.Date
  po_status            String                 @default("DRAFT") @db.VarChar(20)
  buyer_id             Int?
  buyer_name           String?                @db.VarChar(150)
  /// Requisitions the lines were populated from, comma-joined. Derived from the
  /// lines on every save, never trusted from the client.
  req_number           String?                @db.VarChar(200)
  remarks              String?                @db.VarChar(1000)
  total_qty            Int?                   @default(0)
  /// Goods value (Ordered RS on the form); tax_amount is the lines' tax summed,
  /// and total_value the two added. All three are recomputed from the lines on
  /// every save rather than accepted as sent.
  ordered_amount       Decimal?               @default(0) @db.Decimal(14, 2)
  tax_amount           Decimal?               @default(0) @db.Decimal(14, 2)
  total_value          Decimal?               @default(0) @db.Decimal(14, 2)
  cancel_reason        String?                @db.VarChar(500)
  cancelled_at         DateTime?              @db.Timestamp(6)
  created_by           Int?
  updated_by           Int?
  created_at           DateTime?              @default(now()) @db.Timestamp(6)
  updated_at           DateTime?              @default(now()) @db.Timestamp(6)
  supplier_master      supplier_master        @relation(fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  purchase_order_lines purchase_order_lines[]

  @@index([supplier_id], map: "idx_po_hdr_supplier")
  @@index([po_status], map: "idx_po_hdr_status")
  @@index([po_date(sort: Desc)], map: "idx_po_hdr_date")
  @@index([buss_unit_id], map: "idx_po_hdr_bu")
}

/// One ordered item. item_id points at one of five item masters, picked by
/// itemtype — polymorphic, so no relation is declared (same shape as
/// purchase_requisition.item_id).
model purchase_order_lines {
  id                 Int                @id @default(autoincrement())
  po_id              Int
  line_no            Int                @default(1)
  itemtype           String             @db.VarChar(20)
  item_id            Int?
  sku_code           String             @db.VarChar(300)
  item_description   String?            @db.VarChar(500)
  item_qty           Int                @default(0)
  uom                String?            @db.VarChar(20)
  gross_weight       Decimal?           @default(0) @db.Decimal(14, 4)
  net_weight         Decimal?           @default(0) @db.Decimal(14, 4)
  pure_weight        Decimal?           @default(0) @db.Decimal(14, 4)
  /// Four decimals because a metal rate is quoted per gram, and rounding it to
  /// paise before multiplying by a weight loses real money on a large line.
  rate_per_unit      Decimal            @default(0) @db.Decimal(14, 4)
  line_value         Decimal            @default(0) @db.Decimal(14, 2)
  tax_pct            Decimal?           @default(0) @db.Decimal(6, 3)
  tax_amount         Decimal?           @default(0) @db.Decimal(14, 2)
  line_total         Decimal?           @default(0) @db.Decimal(14, 2)
  vendor_item_no     String?            @db.VarChar(100)
  req_number         String?            @db.VarChar(100)
  requested_date     DateTime?          @db.Date
  line_status        String             @default("DRAFT") @db.VarChar(20)
  remarks            String?            @db.VarChar(500)
  created_at         DateTime?          @default(now()) @db.Timestamp(6)
  updated_at         DateTime?          @default(now()) @db.Timestamp(6)
  purchase_order_hdr purchase_order_hdr @relation(fields: [po_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([po_id], map: "idx_po_lines_po")
  @@index([sku_code], map: "idx_po_lines_sku")
  @@index([req_number], map: "idx_po_lines_req")
}

/// Inventory Management → Metal Receipt. One row per received metal lot, the
/// same flat shape purchase_requisition uses: every column the screen carries
/// describes a single lot, and the customer + doc_number pair ties the lines
/// that arrived on one document together rather than a shared header row.
///
/// item_id points at metal_master but declares no relation — the SKU comes from
/// the shared item LOV, and a receipt must still read the way it was entered
/// after the master is re-coded.
///
/// receipt_status is the workflow lifecycle (see constants/orderWorkflow.ts),
/// written only through the workflow engine except for CANCELLED. There is no
/// is_active flag: metal already booked into a sub-inventory is cancelled with a
/// reason, not deactivated.
model metal_receipt {
  id                Int             @id @default(autoincrement())
  receipt_number    String?         @unique @db.VarChar(30)
  receipt_date      DateTime        @default(dbgenerated("CURRENT_DATE")) @db.Date
  customer_id       Int
  doc_number        String?         @db.VarChar(100)
  shipment_location String?         @db.VarChar(300)
  item_id           Int?
  sku_code          String          @db.VarChar(300)
  item_description  String?         @db.VarChar(500)
  /// Identifies the physical lot (bar, grain packet, tag). Indexed, not unique —
  /// untagged metal is entered blank and customers re-use their own numbering.
  uid               String?         @db.VarChar(100)
  purity            String?         @db.VarChar(50)
  received_weight   Decimal         @default(0) @db.Decimal(14, 4)
  pure_weight       Decimal?        @default(0) @db.Decimal(14, 4)
  inward_inv_org    String?         @db.VarChar(50)
  inward_sub_inv    String?         @db.VarChar(100)
  remarks           String?         @db.VarChar(500)
  receipt_status    String          @default("DRAFT") @db.VarChar(20)
  cancel_reason     String?         @db.VarChar(500)
  cancelled_at      DateTime?       @db.Timestamp(6)
  created_by        Int?
  updated_by        Int?
  created_at        DateTime?       @default(now()) @db.Timestamp(6)
  updated_at        DateTime?       @default(now()) @db.Timestamp(6)
  customer_master   customer_master @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([receipt_status], map: "idx_mr_status")
  @@index([receipt_date(sort: Desc)], map: "idx_mr_date")
  @@index([customer_id], map: "idx_mr_customer")
  @@index([doc_number], map: "idx_mr_doc_no")
  @@index([sku_code], map: "idx_mr_sku")
  @@index([uid], map: "idx_mr_uid")
}

/// Append-only stock movement log — the source of truth for every quantity/weight
/// that has ever entered or left a sub-inventory. Written only by
/// stock.service.ts → postStockMovement(), one row per posting, never updated or
/// deleted: a correction is a new REVERSAL row, not an edit to history. quantity /
/// pure_quantity are signed (+in, -out) so a location's position is always
/// SUM(quantity) over its rows, which is exactly what stock_balance caches.
///
/// item_id / sku_code follow the same no-FK convention item_id already has on
/// metal_receipt: the picker is the shared item LOV, and a ledger row must still
/// read the way it posted after the master is re-coded.
model stock_ledger {
  id                 BigInt    @id @default(autoincrement())
  txn_date           DateTime  @default(now()) @db.Timestamp(6)
  /// RECEIPT | ISSUE | REVERSAL | ADJUSTMENT | TRANSFER_IN | TRANSFER_OUT —
  /// only RECEIPT and REVERSAL are posted today (Metal Receipt approve / cancel).
  txn_type           String    @db.VarChar(20)
  /// module_code this movement was posted from (METAL_RECEIPT today), so the
  /// ledger can grow new sources without a schema change.
  source_module      String    @db.VarChar(50)
  source_id          Int
  /// Set on a REVERSAL row: the ledger.id of the RECEIPT it backs out, so an
  /// on-hand discrepancy can be traced to the exact posting it undid.
  reverses_ledger_id BigInt?
  inv_org_code       String?   @db.VarChar(50)
  sub_inv_code       String    @db.VarChar(100)
  /// METAL today; FG / FINDING / STONE / COMPONENT once those modules post here.
  item_type          String    @db.VarChar(20)
  item_id            Int?
  sku_code           String    @db.VarChar(300)
  uid                String?   @db.VarChar(100)
  purity             String?   @db.VarChar(50)
  /// Signed. Grams for METAL; a future piece-counted item_type would store
  /// count here instead — the column carries whatever unit the SKU is tracked in.
  quantity           Decimal   @db.Decimal(14, 4)
  /// Signed fine-metal content of quantity. NULL for item types with no purity
  /// concept (kept nullable rather than 0 so "not applicable" reads distinctly
  /// from "posted zero fine content").
  pure_quantity      Decimal?  @db.Decimal(14, 4)
  remarks            String?   @db.VarChar(500)
  created_by         Int?
  created_at         DateTime  @default(now()) @db.Timestamp(6)

  @@index([sub_inv_code, sku_code, uid], map: "idx_stock_ledger_position")
  @@index([source_module, source_id], map: "idx_stock_ledger_source")
  @@index([txn_date(sort: Desc)], map: "idx_stock_ledger_date")
}

/// Running position per (sub_inv_code, sku_code, uid) — a cache of
/// SUM(stock_ledger.quantity) for that triple, kept current by
/// postStockMovement() in the same transaction as the ledger insert. Rebuildable
/// from stock_ledger alone at any time, so a mismatch is a bug to fix, not data
/// to reconcile by hand.
///
/// uid is NOT NULL (default '') here though stock_ledger.uid is nullable:
/// untagged lots of the same SKU at the same sub-inventory are meant to pool
/// into one balance, and Postgres treats every NULL as distinct for uniqueness
/// purposes, which would silently give each untagged receipt its own row instead.
model stock_balance {
  id             Int      @id @default(autoincrement())
  inv_org_code   String?  @db.VarChar(50)
  sub_inv_code   String   @db.VarChar(100)
  item_type      String   @db.VarChar(20)
  item_id        Int?
  sku_code       String   @db.VarChar(300)
  uid            String   @default("") @db.VarChar(100)
  purity         String?  @db.VarChar(50)
  quantity       Decimal  @default(0) @db.Decimal(14, 4)
  pure_quantity  Decimal? @default(0) @db.Decimal(14, 4)
  last_ledger_id BigInt?
  updated_at     DateTime @default(now()) @db.Timestamp(6)

  @@unique([sub_inv_code, sku_code, uid], name: "sub_inv_sku_uid", map: "uq_stock_balance_position")
  @@index([sku_code], map: "idx_stock_balance_sku")
}

model user_menu_mapping {
  id          Int         @id @default(autoincrement())
  user_id     Int
  menu_id     Int
  can_view    Boolean?
  can_create  Boolean?
  can_update  Boolean?
  can_delete  Boolean?
  can_print   Boolean?
  can_export  Boolean?
  is_active   Boolean?    @default(true)
  created_by  Int?
  updated_by  Int?
  created_at  DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?   @default(now()) @db.Timestamptz(6)
  menu_master menu_master @relation(fields: [menu_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_master user_master @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, menu_id])
  @@index([user_id], map: "idx_user_menu_mapping_user")
}
