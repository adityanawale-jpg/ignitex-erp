generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model audit_log {
  id          Int          @id @default(autoincrement())
  user_id     Int?
  employee_id String?      @db.VarChar(50)
  full_name   String?      @db.VarChar(200)
  action      String       @db.VarChar(50)
  module      String       @db.VarChar(100)
  record_id   String?      @db.VarChar(100)
  description String?
  old_values  Json?
  new_values  Json?
  ip_address  String?      @db.VarChar(50)
  created_at  DateTime     @default(now()) @db.Timestamp(6)
  user_master user_master? @relation(fields: [user_id], references: [user_id], onUpdate: NoAction)
}

model bom_fg {
  id               Int             @id @default(autoincrement())
  variant_id       Int
  bom_version      String          @default("1.0") @db.VarChar(20)
  bom_status       String          @default("DRAFT") @db.VarChar(50)
  gross_weight     Decimal?        @default(0) @db.Decimal(12, 6)
  net_weight       Decimal?        @default(0) @db.Decimal(12, 6)
  min_weight       Decimal?        @db.Decimal(12, 6)
  max_weight       Decimal?        @db.Decimal(12, 6)
  stone_cts        Decimal?        @default(0) @db.Decimal(12, 6)
  stone_gms        Decimal?        @default(0) @db.Decimal(12, 6)
  effective_from   DateTime?       @db.Date
  effective_to     DateTime?       @db.Date
  remarks          String?
  submitted_by     Int?
  submitted_at     DateTime?       @db.Timestamp(6)
  approved_by      Int?
  approved_at      DateTime?       @db.Timestamp(6)
  rejected_by      Int?
  rejected_at      DateTime?       @db.Timestamp(6)
  rejection_reason String?
  is_active        Boolean?        @default(true)
  created_by       Int
  updated_by       Int?
  created_at       DateTime?       @default(now()) @db.Timestamp(6)
  updated_at       DateTime?       @default(now()) @db.Timestamp(6)
  component_weight Decimal?        @default(0) @db.Decimal(12, 6)
  item_variant     fg_item_variant @relation(fields: [variant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bom_fg_detail    bom_fg_detail[]

  @@index([bom_status], map: "idx_bom_fg_status")
  @@index([variant_id], map: "idx_bom_fg_variant")
}

model bom_fg_detail {
  id               Int       @id @default(autoincrement())
