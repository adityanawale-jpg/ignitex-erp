  item_name        String?   @db.VarChar(300)
  item_quantity    Decimal?  @default(1) @db.Decimal(12, 4)
  uom1_code        String?   @db.VarChar(50)
  item_weight      Decimal?  @db.Decimal(12, 6)
  uom2_code        String?   @db.VarChar(50)
  purity_code      String?   @db.VarChar(50)
  pure_weight      Decimal?  @db.Decimal(12, 6)
  weight_gms       Decimal?  @db.Decimal(12, 6)
  remarks          String?
  is_active        Boolean?  @default(true)
  created_by       Int?
  updated_by       Int?
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)
  gross_weight     Decimal?  @default(0) @db.Decimal(12, 6)
  net_weight       Decimal?  @default(0) @db.Decimal(12, 6)
  stone_cts        Decimal?  @default(0) @db.Decimal(12, 6)
