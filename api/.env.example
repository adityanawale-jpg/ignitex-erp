# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ignitex_erp
DB_USER=postgres
DB_PASSWORD=your-db-password-here
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_SSL=false

# JWT Configuration
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# API Security
BCRYPT_ROUNDS=10

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Redis (optional — query/permission cache + rate-limit store).
# Leave unset to run without a cache; falls back to direct DB queries
# and an in-memory rate-limit store.
REDIS_URL=redis://localhost:6379

# GCP Secret Manager (optional). Set this to pull DB_PASSWORD and JWT_SECRET
# from Secret Manager at startup instead of the plain values above — see
# README "Secrets" for the gcloud setup this requires. Leave unset for local
# dev; DB_PASSWORD/JWT_SECRET above are used as-is.
GCP_PROJECT_ID=
