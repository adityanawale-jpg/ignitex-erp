# API base URL
# Development (proxied): /api/v1
# Production (direct):   http://YOUR_SERVER_IP:5000/api/v1
VITE_API_BASE_URL=/api/v1

# API server origin for static file assets (uploaded images, avatars, etc.)
# Leave empty in development (dev proxy handles it)
# Production: set to the API server origin WITHOUT trailing slash
# e.g. VITE_UPLOADS_BASE_URL=http://35.253.45.137:5000
VITE_UPLOADS_BASE_URL=

# App display info
VITE_APP_NAME=IgniteX.ai ERP
VITE_APP_VERSION=1.0.0
