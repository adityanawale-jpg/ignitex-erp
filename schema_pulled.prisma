model user_menu_mapping {
  id          Int         @id @default(autoincrement())
  user_id     Int
  menu_id     Int
  can_view    Boolean?
  can_create  Boolean?
  can_update  Boolean?
  can_delete  Boolean?
  can_print   Boolean?
  can_export  Boolean?
  is_active   Boolean?    @default(true)
  created_by  Int?
  updated_by  Int?
  created_at  DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?   @default(now()) @db.Timestamptz(6)
  menu_master menu_master @relation(fields: [menu_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_master user_master @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, menu_id])
  @@index([user_id], map: "idx_user_menu_mapping_user")
}


