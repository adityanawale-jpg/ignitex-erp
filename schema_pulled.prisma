  zinc_surface            String?                   @db.VarChar(100)
  zinc_die_number         String?                   @db.VarChar(100)
  zinc_weight             Decimal?                  @db.Decimal(10, 4)
  seo_words               String?
  usp                     String?
  short_description       String?
  long_description        String?
  retail_brand            String?                   @db.VarChar(100)
  keywords_tags           String?
  product_title           String?                   @db.VarChar(300)
  is_active               Boolean?                  @default(true)
  created_at              DateTime?                 @default(now()) @db.Timestamp(6)
  updated_at              DateTime?                 @default(now()) @db.Timestamp(6)
  gross_weight            Decimal?                  @db.Decimal(12, 4)
  net_weight              Decimal?                  @db.Decimal(12, 4)
  bom_fin                 bom_fin[]
  fin_item_master         fin_item_master           @relation(fields: [item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fin_item_variant_client fin_item_variant_client[]

  @@index([item_id], map: "idx_fin_variant_item")
}

model fin_item_variant_client {
