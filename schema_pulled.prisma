  created_by          Int?
  updated_by          Int?
  created_at          DateTime  @default(now()) @db.Timestamp(6)
  updated_at          DateTime  @default(now()) @db.Timestamp(6)

  @@index([is_active], map: "idx_machine_active")
  @@index([machine_code], map: "idx_machine_code")
  @@index([dept_id], map: "idx_machine_dept")
  @@index([machine_type], map: "idx_machine_type")
