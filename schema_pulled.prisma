  customer_name         String?          @db.VarChar(255)
  customer_variant_code String?          @db.VarChar(100)
  customer_variant_name String?          @db.VarChar(200)
  alloy_code            String?          @db.VarChar(50)
  group_sales           String?          @db.VarChar(100)
  is_active             Boolean?         @default(true)
  created_at            DateTime?        @default(now()) @db.Timestamp(6)
  fin_item_variant      fin_item_variant @relation(fields: [variant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([variant_id], map: "idx_fin_ivc_variant")
}

model inventory_structure {
